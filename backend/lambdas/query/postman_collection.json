{
  "info": {
    "name": "Pacific BioArchive — Database & Query API",
    "description": "Member D public endpoints (Member E frontend). Set `baseUrl` to http://localhost:8000 for local dev.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" }
  ],
  "item": [
    {
      "name": "Find by tags (AND + min counts)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/query/by-tags", "host": ["{{baseUrl}}"], "path": ["query", "by-tags"] },
        "body": { "mode": "raw", "raw": "{\"tags\": {\"dingo\": 1, \"wombat\": 1}}" }
      }
    },
    {
      "name": "Find by species",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/query/by-species", "host": ["{{baseUrl}}"], "path": ["query", "by-species"] },
        "body": { "mode": "raw", "raw": "{\"species\": \"magpie\"}" }
      }
    },
    {
      "name": "Find by thumbnail key",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/query/by-thumbnail?key=thumbnails/u1/a1.jpg",
          "host": ["{{baseUrl}}"],
          "path": ["query", "by-thumbnail"],
          "query": [{ "key": "key", "value": "thumbnails/u1/a1.jpg" }]
        }
      }
    },
    {
      "name": "Find by uploaded file",
      "request": {
        "method": "POST",
        "url": { "raw": "{{baseUrl}}/query/by-file", "host": ["{{baseUrl}}"], "path": ["query", "by-file"] },
        "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "query.jpg" }] }
      }
    },
    {
      "name": "Bulk add tags",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/tags/edit", "host": ["{{baseUrl}}"], "path": ["tags", "edit"] },
        "body": {
          "mode": "raw",
          "raw": "{\"keys\": [\"originals/u1/a1.jpg\"], \"urls\": [], \"tags\": [\"echidna\"], \"operation\": 1}"
        }
      }
    },
    {
      "name": "Bulk remove tags (ignore missing)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/tags/edit", "host": ["{{baseUrl}}"], "path": ["tags", "edit"] },
        "body": {
          "mode": "raw",
          "raw": "{\"keys\": [\"originals/u1/a1.jpg\"], \"tags\": [\"koala\"], \"operation\": 0}"
        }
      }
    },
    {
      "name": "Bulk delete files",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/files/delete", "host": ["{{baseUrl}}"], "path": ["files", "delete"] },
        "body": { "mode": "raw", "raw": "{\"keys\": [\"originals/u1/a5.jpg\"], \"urls\": []}" }
      }
    },
    {
      "name": "Subscribe to a species",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/notifications/subscribe", "host": ["{{baseUrl}}"], "path": ["notifications", "subscribe"] },
        "body": { "mode": "raw", "raw": "{\"user_id\": \"u1\", \"species\": \"wombat\"}" }
      }
    },
    {
      "name": "Unsubscribe from a species",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/notifications/subscribe?user_id=u1&species=wombat",
          "host": ["{{baseUrl}}"],
          "path": ["notifications", "subscribe"],
          "query": [
            { "key": "user_id", "value": "u1" },
            { "key": "species", "value": "wombat" }
          ]
        }
      }
    },
    {
      "name": "List my subscriptions",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/notifications/subscriptions?user_id=u1",
          "host": ["{{baseUrl}}"],
          "path": ["notifications", "subscriptions"],
          "query": [{ "key": "user_id", "value": "u1" }]
        }
      }
    },
    {
      "name": "List my notifications",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/notifications?user_id=u1",
          "host": ["{{baseUrl}}"],
          "path": ["notifications"],
          "query": [{ "key": "user_id", "value": "u1" }]
        }
      }
    }
  ]
}
