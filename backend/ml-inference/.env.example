INFERENCE_BACKEND=speciesnet
ANIMAL_DETECTOR=megadetector
MODEL_VERSION=v1
MODEL_PATH=/app/models/model.pt
DETECTOR_MODEL_PATH=/app/models/mdv5a.pt
LABELS_PATH=/app/config/labels.txt
INTERNAL_API_KEY=replace-with-a-secret
MAX_REQUEST_BYTES=26214400
MAX_IMAGE_BYTES=12582912
MAX_SOURCE_URLS=900
INFER_TIMEOUT_SECONDS=45
REMOTE_URL_TIMEOUT_SECONDS=20
ALLOW_REMOTE_URLS=true
CONFIDENCE_THRESHOLD=0.05
TORCH_DEVICE=cpu
MPLCONFIGDIR=/tmp/pacific-bioarchive-mpl
YOLOV5_CONFIG_DIR=/tmp/pacific-bioarchive-yolo
